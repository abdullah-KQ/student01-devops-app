pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        IMAGE_NAME     = 'student01-devops-app'
        APP_SERVER     = '172.31.91.253'
        CONTAINER_NAME = 'student01-devops-app'
        APP_PORT       = '8101'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '===== STAGE 1 - CHECKOUT ====='

                checkout scm

                sh '''
                    echo "Repository downloaded successfully"
                    echo "Current workspace:"
                    pwd

                    echo "Project files:"
                    ls -la
                '''
            }
        }

        stage('Build') {
            steps {
                echo '===== STAGE 2 - BUILD ====='

                sh '''
                    echo "Cleaning old build directory..."
                    rm -rf build

                    echo "Creating new build directory..."
                    mkdir build

                    echo "Copying application files..."
                    cp index.html build/
                    cp README.md build/

                    echo "Build directory contents:"
                    ls -la build
                '''

                echo 'BUILD COMPLETED SUCCESSFULLY'
            }
        }

        stage('Test') {
            steps {
                echo '===== STAGE 3 - TEST ====='

                sh '''
                    echo "Test 1: Checking index.html exists..."
                    test -f build/index.html

                    echo "Test 1 PASSED"

                    echo "Test 2: Checking index.html is not empty..."
                    test -s build/index.html

                    echo "Test 2 PASSED"

                    echo "Test 3: Checking DevOps text exists..."
                    grep -q "DevOps" build/index.html

                    echo "Test 3 PASSED"
                '''

                echo 'ALL APPLICATION TESTS PASSED'
            }
        }

        stage('Docker Build') {
            steps {
                echo '===== STAGE 4 - DOCKER BUILD ====='

                sh '''
                    echo "Building Docker Image..."

                    docker build \
                    -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                    -t ${IMAGE_NAME}:latest \
                    .

                    echo "Docker Image created successfully"

                    docker images ${IMAGE_NAME}
                '''

                echo 'DOCKER IMAGE BUILD COMPLETED'
            }
        }

        stage('Docker Test') {
            steps {
                echo '===== STAGE 5 - DOCKER TEST ====='

                sh '''
                    TEST_CONTAINER="${IMAGE_NAME}-test-${BUILD_NUMBER}"

                    echo "Starting temporary test container..."

                    docker rm -f "$TEST_CONTAINER" 2>/dev/null || true

                    docker run -d \
                    --name "$TEST_CONTAINER" \
                    ${IMAGE_NAME}:${BUILD_NUMBER}

                    sleep 2

                    echo "Checking index.html inside container..."

                    docker exec "$TEST_CONTAINER" \
                    test -f /usr/share/nginx/html/index.html

                    echo "Checking application content inside container..."

                    docker exec "$TEST_CONTAINER" \
                    grep -q "DevOps" /usr/share/nginx/html/index.html

                    echo "Removing temporary test container..."

                    docker rm -f "$TEST_CONTAINER"
                '''

                echo 'DOCKER IMAGE TEST PASSED'
            }
        }

        stage('Transfer Image') {
            steps {
                echo '===== STAGE 6 - TRANSFER IMAGE ====='

                sh '''
                    echo "Transferring Docker Image to Application Server..."

                    docker save ${IMAGE_NAME}:${BUILD_NUMBER} | \
                    ssh -o BatchMode=yes deploy@${APP_SERVER} "docker load"
                '''

                echo 'DOCKER IMAGE TRANSFERRED SUCCESSFULLY'
            }
        }

        stage('Deploy') {
            steps {
                echo '===== STAGE 7 - DEPLOY ====='

                sh '''
                    echo "Deploying new application version..."

                    ssh -o BatchMode=yes deploy@${APP_SERVER} "
                        echo 'Removing old container if it exists...'

                        docker rm -f ${CONTAINER_NAME} 2>/dev/null || true

                        echo 'Starting new container...'

                        docker run -d \
                        --name ${CONTAINER_NAME} \
                        --restart unless-stopped \
                        -p ${APP_PORT}:80 \
                        ${IMAGE_NAME}:${BUILD_NUMBER}
                    "
                '''

                echo 'APPLICATION DEPLOYED SUCCESSFULLY'
            }
        }

        stage('Verify Deployment') {
            steps {
                echo '===== STAGE 8 - VERIFY DEPLOYMENT ====='

                sh '''
                    echo "Waiting for application to start..."
                    sleep 3

                    echo "Testing application on Application Server..."

                    ssh -o BatchMode=yes deploy@${APP_SERVER} \
                    "curl -fsS http://localhost:${APP_PORT} | grep -q 'DevOps'"

                    echo "Checking running container..."

                    ssh -o BatchMode=yes deploy@${APP_SERVER} \
                    "docker ps --filter name=${CONTAINER_NAME}"
                '''

                echo 'APPLICATION VERIFICATION PASSED'
            }
        }

        stage('Deployment Information') {
            steps {
                echo '===== STAGE 9 - DEPLOYMENT INFORMATION ====='

                sh '''
                    ssh -o BatchMode=yes deploy@${APP_SERVER} "
                        echo 'Running Container:'
                        docker ps --filter name=${CONTAINER_NAME}

                        echo 'Docker Image Used:'
                        docker inspect ${CONTAINER_NAME} \
                        --format '{{.Config.Image}}'
                    "
                '''
            }
        }
    }

    post {

        success {
            echo '========================================='
            echo 'CI/CD PIPELINE COMPLETED SUCCESSFULLY'
            echo 'APPLICATION DEPLOYED SUCCESSFULLY'
            echo '========================================='
        }

        failure {
            echo '========================================='
            echo 'CI/CD PIPELINE FAILED'
            echo 'CHECK THE FAILED STAGE'
            echo '========================================='
        }

        always {
            sh '''
                docker rm -f ${IMAGE_NAME}-test-${BUILD_NUMBER} \
                2>/dev/null || true
            '''
        }
    }
}
