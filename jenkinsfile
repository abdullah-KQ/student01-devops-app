pipeline {
    agent any

    environment {
        REGISTRY = 'localhost:5000'
        IMAGE_NAME = 'student01-registry-app'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                    -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                    .
                '''
            }
        }

        stage('Tag Docker Image') {
            steps {
                sh '''
                    docker tag \
                    ${IMAGE_NAME}:${BUILD_NUMBER} \
                    ${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}

                    docker tag \
                    ${IMAGE_NAME}:${BUILD_NUMBER} \
                    ${REGISTRY}/${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                sh '''
                    docker push \
                    ${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}

                    docker push \
                    ${REGISTRY}/${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Verify Registry') {
            steps {
                sh '''
                    curl -s \
                    http://localhost:5000/v2/${IMAGE_NAME}/tags/list
                '''
            }
        }
    }

    post {
        success {
            echo 'Docker image built, tagged and pushed successfully.'
        }

        failure {
            echo 'Pipeline failed. Review the Jenkins console output.'
        }
    }
}
