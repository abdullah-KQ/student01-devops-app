pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        IMAGE_NAME = 'student01-devops-app'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Stage 1 - Source Code Checkout'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Stage 2 - Build Started'

                sh '''
                    rm -rf build
                    mkdir build
                    cp index.html build/
                    cp README.md build/
                    ls -la build
                '''

                echo 'Stage 2 - Build Completed'
            }
        }

        stage('Test') {
            steps {
                echo 'Stage 3 - Tests Started'

                sh '''
                    test -f build/index.html
                    test -s build/index.html
                    grep -q "Basic DevOps" build/index.html
                '''

                echo 'Stage 3 - All Tests Passed'
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Stage 4 - Docker Image Build Started'

                sh '''
                    docker build \
                    -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                    -t ${IMAGE_NAME}:latest \
                    .
                '''

                echo 'Stage 4 - Docker Image Build Completed'
            }
        }

        stage('Docker Test') {
            steps {
                echo 'Stage 5 - Docker Image Test Started'

                sh '''
                    CID=$(docker run -d ${IMAGE_NAME}:${BUILD_NUMBER})

                    sleep 2

                    docker exec "$CID" test -f /usr/share/nginx/html/index.html

                    docker exec "$CID" grep -q "Basic DevOps" /usr/share/nginx/html/index.html

                    docker rm -f "$CID"
                '''

                echo 'Stage 5 - Docker Image Test Passed'
            }
        }

        stage('Docker Image Info') {
            steps {
                echo 'Stage 6 - Docker Image Information'

                sh '''
                    docker images ${IMAGE_NAME}
                '''
            }
        }
    }

    post {

        success {
            echo 'DOCKER PIPELINE COMPLETED SUCCESSFULLY'
        }

        failure {
            echo 'DOCKER PIPELINE FAILED'
        }
    }
}
